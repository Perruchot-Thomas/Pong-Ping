[Unit]
Description=Pong Ping - jeu de ping-pong inverse en ligne
After=network.target

[Service]
Type=simple
User=etudiant
WorkingDirectory=/var/www/pongping/Pong-Ping
Environment="PORT=3001"
Environment="NODE_ENV=production"
ExecStart=/home/etudiant/.bun/bin/bun /var/www/pongping/Pong-Ping/server.js
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
